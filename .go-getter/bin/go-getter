#!/bin/sh
# Generated by go-getter apply; do not edit. Runs the go-getter CLI when Node >= 22 is available,
# otherwise warns and exits 0 so enforcement degrades to advisory (decision 0019).
# Order: a go-getter checkout, GO_GETTER_CLI (compiler/bin/go-getter.mjs of a checkout), the CLI copy in .go-getter/cli, then npx.
FLOOR=22
if ! command -v node >/dev/null 2>&1; then
  echo "go-getter: enforcement unavailable: Node >= $FLOOR not found" >&2
  exit 0
fi
MAJOR=$(node -p 'process.versions.node.split(".")[0]')
if [ "$MAJOR" -lt "$FLOOR" ]; then
  echo "go-getter: enforcement unavailable: Node $MAJOR < $FLOOR" >&2
  exit 0
fi
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [ -f "$ROOT/compiler/bin/go-getter.mjs" ] && grep -q '"name": "go-getter"' "$ROOT/package.json" 2>/dev/null; then
  exec node "$ROOT/compiler/bin/go-getter.mjs" "$@"
fi
if [ -n "$GO_GETTER_CLI" ]; then
  if [ -f "$GO_GETTER_CLI" ]; then
    exec node "$GO_GETTER_CLI" "$@"
  fi
  echo "go-getter: GO_GETTER_CLI=$GO_GETTER_CLI is not a file; trying npx" >&2
fi
if [ -f "$ROOT/.go-getter/cli/compiler/bin/go-getter.mjs" ]; then
  exec node "$ROOT/.go-getter/cli/compiler/bin/go-getter.mjs" "$@"
fi
ERR=$(mktemp 2>/dev/null) || exec npx --yes github:vivantel/go-getter#v0.2.0 "$@"
npx --yes github:vivantel/go-getter#v0.2.0 "$@" 2>"$ERR"
CODE=$?
cat "$ERR" >&2
if [ "$CODE" -ne 0 ] && grep -q '^npm error' "$ERR"; then
  echo "go-getter: npx could not run the CLI (npm error above), so this call was not enforced. Re-run go-getter apply to vendor a CLI copy into .go-getter/cli, set GO_GETTER_CLI to compiler/bin/go-getter.mjs of a go-getter checkout, or allow git fetches for npm (npm_config_allow_git=all)." >&2
fi
rm -f "$ERR"
exit $CODE
