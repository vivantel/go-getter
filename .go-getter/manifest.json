        "items": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "sh -c 'd=$PWD; while [ ! -f \"$d/.go-getter/bin/go-getter\" ] && [ \"$d\" != / ]; do d=$(dirname \"$d\"); done; [ -f \"$d/.go-getter/bin/go-getter\" ] || { echo \"go-getter: runner not found; hook skipped\" >&2; exit 0; }; exec sh \"$d/.go-getter/bin/go-getter\" hook post-tool --host claude-code --project \"$d\"'"
