#!/bin/sh
# Generated by go-getter build; do not edit. Runs the CLI bundled with the go-getter-init skill.
CLI="$(dirname "$0")/../skills/go-getter-init/cli/compiler/bin/go-getter.mjs"
if [ ! -f "$CLI" ]; then
  echo "go-getter: the bundled CLI is missing; reinstall the go-getter plugin" >&2
  exit 127
fi
if ! command -v node >/dev/null 2>&1; then
  echo "go-getter: Node.js is required to run the CLI; enforcement stays advisory until it is installed" >&2
  exit 127
fi
exec node "$CLI" "$@"
