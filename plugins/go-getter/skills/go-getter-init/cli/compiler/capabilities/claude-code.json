{
  "$schema": "../schemas/capabilities.schema.json",
  "host": "claude-code",
  "fact": "0003-claude-code-integration-surface",
  "instructions": {
    "file": "CLAUDE.md",
    "readsAgentsMd": false,
    "agentsMdVia": "symlink"
  },
  "skills": {
    "dirs": [
      ".claude/skills"
    ]
  },
  "agents": {
    "format": "markdown",
    "dir": ".claude/agents",
    "extension": ".md",
    "model": true,
    "effort": true,
    "tools": true,
    "nesting": 3
  },
  "commands": {
    "native": false
  },
  "hooks": {
    "config": ".claude/settings.json",
    "blockPreTool": true,
    "rewriteToolInput": true,
    "rewriteOutput": true,
    "blockStop": true,
    "modelSwap": false,
    "runtime": "command",
    "watcher": { "tool": "Monitor", "field": "command" }
  },
  "permissions": {
    "pathReadDeny": true,
    "config": ".claude/settings.json"
  },
  "routing": {
    "localEndpoints": true,
    "spendCap": "headless",
    "cacheTokensVisible": true,
    "cacheTtl": {
      "file": ".claude/settings.json",
      "main": [
        "promptCacheTtl"
      ],
      "subagent": [
        "subagentPromptCacheTtl"
      ]
    },
    "delegation": {
      "tool": "Agent",
      "update": "hookSpecificOutput",
      "models": [
        { "prefix": "claude-fable-", "alias": "fable" },
        { "prefix": "claude-opus-", "alias": "opus" },
        { "prefix": "claude-sonnet-", "alias": "sonnet" },
        { "prefix": "claude-haiku-", "alias": "haiku" }
      ]
    }
  },
  "telemetry": {
    "otel": true,
    "cost": true,
    "logsPromptsByDefault": false
  },
  "sandbox": true,
  "checkpointing": true,
  "nodeAtRuntime": false,
  "tiers": {
    "3": 2,
    "6": 2,
    "7": 2,
    "8": 2,
    "9": 2,
    "10": 2,
    "11": 2,
    "12": 2
  },
  "notes": [
    "Plugins cannot ship permissions settings; project-local .claude/settings.json carries permissions and hooks.",
    "Endpoints must speak the Anthropic Messages API.",
    "Checkpointing covers file-tool edits only."
  ]
}
