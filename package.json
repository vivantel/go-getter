{
  "name": "go-getter",
  "version": "0.5.0",
  "private": true,
  "description": "Set up the agent harness and SDLC practices for Claude Code, Codex, Kilo, OpenCode, Cursor, Gemini CLI and Copilot",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "go-getter": "compiler/bin/go-getter.mjs"
  },
  "scripts": {
    "build": "node compiler/bin/go-getter.mjs build",
    "test": "node --import ./compiler/test/support/tmp-cleanup.mjs --test \"compiler/test/**/*.test.mjs\"",
    "test:update": "node --import ./compiler/test/support/tmp-cleanup.mjs --test \"compiler/test/update/**/*.test.mjs\"",
    "test:routing": "node --import ./compiler/test/support/tmp-cleanup.mjs --test \"compiler/test/routing/**/*.test.mjs\"",
    "test:telemetry": "node --import ./compiler/test/support/tmp-cleanup.mjs --test \"compiler/test/telemetry/**/*.test.mjs\"",
    "check:generated": "node compiler/bin/go-getter.mjs check generated",
    "check:neutral": "node compiler/bin/go-getter.mjs check neutral",
    "check:guardrails": "node compiler/bin/go-getter.mjs check guardrails",
    "check:tags": "node compiler/bin/go-getter.mjs check tags",
    "check:node-floor": "node compiler/bin/go-getter.mjs check node-floor",
    "check:self-adoption": "node compiler/bin/go-getter.mjs check self-adoption",
    "check:versions": "node compiler/bin/go-getter.mjs check versions",
    "check:plugin-pin": "node compiler/bin/go-getter.mjs check plugin-pin",
    "check:deps": "node compiler/bin/go-getter.mjs check deps",
    "check:packs": "node compiler/bin/go-getter.mjs check packs",
    "check:plans": "node compiler/bin/go-getter.mjs check plans",
    "check:indexes": "node compiler/bin/go-getter.mjs check indexes",
    "eval": "node compiler/bin/go-getter.mjs eval",
    "e2e:lifecycle": "node scripts/e2e/lifecycle.mjs"
  },
  "devDependencies": {
    "promptfoo": "0.123.1"
  }
}
