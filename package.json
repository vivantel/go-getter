{
  "name": "go-getter",
  "version": "0.0.0",
  "private": true,
  "description": "Set up the agent harness and SDLC practices for Claude Code, Codex, Kilo/OpenCode, Cursor, Gemini CLI and Copilot",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "go-getter": "compiler/bin/go-getter.mjs"
  },
  "scripts": {
    "build": "node compiler/bin/go-getter.mjs build",
    "test": "node --test \"compiler/test/**/*.test.mjs\"",
    "test:routing": "node --test \"compiler/test/routing/**/*.test.mjs\"",
    "test:telemetry": "node --test \"compiler/test/telemetry/**/*.test.mjs\"",
    "sync:kms": "node scripts/sync-kms.mjs",
    "check:generated": "node compiler/bin/go-getter.mjs check generated",
    "check:neutral": "node compiler/bin/go-getter.mjs check neutral",
    "check:guardrails": "node compiler/bin/go-getter.mjs check guardrails",
    "check:tags": "node compiler/bin/go-getter.mjs check tags",
    "check:node-floor": "node compiler/bin/go-getter.mjs check node-floor",
    "check:self-adoption": "node compiler/bin/go-getter.mjs check self-adoption",
    "check:vendor": "node compiler/bin/go-getter.mjs check vendor",
    "check:deps": "node compiler/bin/go-getter.mjs check deps",
    "check:packs": "node compiler/bin/go-getter.mjs check packs",
    "eval": "node compiler/bin/go-getter.mjs eval"
  },
  "devDependencies": {
    "promptfoo": "0.123.1"
  }
}
