{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .go-getter/bin/go-getter hook session-start --host claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .go-getter/bin/go-getter hook pre-tool --host claude-code"
          }
        ]
      }
    ]
  }
}
